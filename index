    <!-- Application Script -->
    <script>
        lucide.createIcons();

        // 🟢 กำหนดลิงก์ API ของ Google Apps Script เรียบร้อยแล้ว
        const API_URL = "https://script.google.com/macros/s/AKfycbwUSBA0S15_6l-fWHQ7Wvz_zq4SMQbjIWyPFJTYtEpz6DCgWLkWZ5Yd6iMu5md7qf7i-A/exec";

        const AppState = {
            activities: [
                { id: 'ACT001', name: 'กิจกรรมเพื่อสังคมและสาธารณประโยชน์', semester: '1', year: '2569', date: '2026-06-01', hours: 15 }
            ],
            students: [],
            evaluations: {},
            classes: {}
        };

        let currentEvalContext = { activityId: null, grade: null, room: null, students: [] };
        
        let overviewChartInstance = null;
        let gradeChartInstance = null;

        const loadingOverlay = document.getElementById('loading-overlay');
        const loadingText = document.getElementById('loading-text');

        function showLoading(text = 'กำลังโหลด...') {
            loadingText.innerText = text;
            loadingOverlay.classList.remove('hidden');
        }

        function hideLoading() {
            loadingOverlay.classList.add('hidden');
        }

        const today = new Date();
        document.getElementById('current-date-display').innerText = today.toLocaleDateString('th-TH', {
            year: 'numeric', month: 'long', day: 'numeric'
        });

        function getUniqueId() {
            return Math.random().toString(36).substr(2, 9);
        }

        // --- Navigation ---
        function navigate(pageId) {
            document.querySelectorAll('.page-content').forEach(el => {
                el.classList.add('hidden');
                el.classList.remove('block');
            });
            
            const targetPage = document.getElementById(`page-${pageId}`);
            if (targetPage) {
                targetPage.classList.remove('hidden');
                targetPage.classList.add('block');
            }

            document.querySelectorAll('.nav-item').forEach(el => {
                el.classList.remove('sidebar-active');
                if (el.dataset.page === pageId) {
                    el.classList.add('sidebar-active');
                    document.getElementById('page-title').innerText = el.querySelector('span').innerText;
                }
            });

            if(window.innerWidth < 768) toggleSidebar(false);

            if (pageId === 'dashboard') initDashboard();
            if (pageId === 'activities') renderActivities();
            if (pageId === 'students') renderStudentsTable();
            if (pageId === 'evaluate' || pageId === 'summary' || pageId === 'report') {
                populateActivitySelects();
                updateClassDropdown('eval');
                updateClassDropdown('rep');
            }
        }

        function toggleSidebar(forceState = null) {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            const isOpen = !sidebar.classList.contains('-translate-x-full');
            const toOpen = forceState !== null ? forceState : !isOpen;

            if (toOpen) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        // --- Class Dropdowns Dynamic Extractor ---
        function extractClassesFromStudents() {
            AppState.classes = {};
            AppState.students.forEach(st => {
                let g = st.grade ? String(st.grade).trim() : '';
                let r = st.room !== undefined && st.room !== null ? String(st.room).trim() : '';
                
                if(g.includes('/')) {
                    const parts = g.split('/');
                    g = parts[0].trim();
                    if(!r) r = parts[1].trim();
                }

                if(g && r !== '') {
                    if(!AppState.classes[g]) AppState.classes[g] = [];
                    if(!AppState.classes[g].includes(r)) AppState.classes[g].push(r);
                }
            });
            for(let grade in AppState.classes) {
                AppState.classes[grade].sort((a, b) => Number(a) - Number(b));
            }
        }

        function updateClassDropdown(prefix) {
            const gradeSelect = document.getElementById(`${prefix}-grade`);
            const roomSelect = document.getElementById(`${prefix}-room`);
            if(!gradeSelect || !roomSelect) return;

            const selectedGrade = gradeSelect.value.trim();
            const currentSelectedRoom = roomSelect.value;
            roomSelect.innerHTML = '<option value="">-- เลือกห้อง --</option>';
            
            if (selectedGrade && AppState.classes[selectedGrade] && AppState.classes[selectedGrade].length > 0) {
                roomSelect.disabled = false;
                AppState.classes[selectedGrade].forEach(room => {
                    const opt = document.createElement('option');
                    opt.value = room;
                    opt.textContent = `ห้อง ${room}`;
                    if(room === currentSelectedRoom) opt.selected = true;
                    roomSelect.appendChild(opt);
                });
            } else {
                roomSelect.disabled = true;
            }
        }

        function populateActivitySelects() {
            ['eval', 'sum', 'rep'].forEach(prefix => {
                const select = document.getElementById(`${prefix}-activity`);
                if (!select) return;
                const currVal = select.value;
                select.innerHTML = '<option value="">-- เลือกกิจกรรม --</option>';
                
                AppState.activities.forEach(act => {
                    const opt = document.createElement('option');
                    opt.value = act.id;
                    opt.textContent = `${act.name} (${act.semester}/${act.year})`;
                    select.appendChild(opt);
                });
                if(currVal) select.value = currVal;
                else if(AppState.activities.length > 0) select.value = AppState.activities[0].id;
            });
        }

        // --- Students & Excel Handler ---
        function handleExcelUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            showLoading('กำลังอ่านไฟล์ Excel...');
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, {type: 'array'});
                    const worksheet = workbook.Sheets[workbook.SheetNames[0]];
                    const json = XLSX.utils.sheet_to_json(worksheet, {header: 1});
                    
                    if(json.length <= 1) throw new Error("ไม่พบข้อมูลในไฟล์ หรือมีแต่หัวตาราง");

                    let headers = json[0].map(h => String(h).trim().toLowerCase());
                    let newStudents = [];
                    let counter = 1;

                    let idxNo = headers.findIndex(h => h.includes('เลขที่') || h.includes('ลำดับ') || h === 'no');
                    let idxId = headers.findIndex(h => h.includes('รหัส') || h.includes('ประจำตัว') || h === 'id');
                    let idxName = headers.findIndex(h => h.includes('ชื่อ') && !h.includes('สกุล'));
                    let idxSurname = headers.findIndex(h => h.includes('นามสกุล') || h.includes('สกุล') && !h.includes('ชื่อ'));
                    let idxFullName = headers.findIndex(h => h.includes('ชื่อ-สกุล') || h.includes('ชื่อ - นามสกุล'));
                    let idxGrade = headers.findIndex(h => h.includes('ชั้น') || h.includes('ระดับ'));
                    let idxRoom = headers.findIndex(h => h.includes('ห้อง'));

                    for(let i = 1; i < json.length; i++) {
                        let row = json[i];
                        if(!row || row.length === 0 || row.join('').trim() === '') continue;

                        let number = idxNo !== -1 && row[idxNo] !== undefined ? String(row[idxNo]).trim() : counter++;
                        let stId = idxId !== -1 && row[idxId] !== undefined ? String(row[idxId]).trim() : '69' + String(i).padStart(3, '0');
                        let name = '';
                        let surname = '';

                        if(idxFullName !== -1 && row[idxFullName]) {
                            let parts = String(row[idxFullName]).trim().split(/\s+/);
                            name = parts[0] || '';
                            surname = parts.slice(1).join(' ') || '';
                        } else {
                            if(idxName !== -1 && row[idxName]) name = String(row[idxName]).trim();
                            if(idxSurname !== -1 && row[idxSurname]) surname = String(row[idxSurname]).trim();
                        }

                        let grade = idxGrade !== -1 && row[idxGrade] !== undefined ? String(row[idxGrade]).trim() : 'ม.1';
                        let room = idxRoom !== -1 && row[idxRoom] !== undefined ? String(row[idxRoom]).trim() : '1';

                        if(grade && !grade.includes('ม.')) grade = 'ม.' + grade;
                        if(grade.includes('/')) {
                            const p = grade.split('/');
                            grade = p[0].trim();
                            room = p[1].trim();
                        }

                        if(name || stId) {
                            newStudents.push({
                                id: getUniqueId(),
                                student_id: stId,
                                firstname: name || '-',
                                lastname: surname || '',
                                grade: grade || 'ม.1',
                                room: room || '1',
                                number: number
                            });
                        }
                    }

                    if(newStudents.length > 0) {
                        AppState.students = AppState.students.concat(newStudents);
                        
                        const uniqueIds = new Set();
                        AppState.students = AppState.students.filter(st => {
                            if(uniqueIds.has(st.student_id)) return false;
                            uniqueIds.add(st.student_id);
                            return true;
                        });

                        extractClassesFromStudents();
                        renderStudentsTable();
                        updateClassDropdown('filter');
                        updateClassDropdown('eval');
                        updateClassDropdown('rep');

                        // ส่งข้อมูลขึ้น Google Sheet API
                        fetch(API_URL, {
                            method: 'POST',
                            body: JSON.stringify({ action: 'saveStudents', payload: newStudents })
                        }).catch(err => console.log('Sync offline'));

                        Swal.fire('สำเร็จ', `นำเข้ารายชื่อนักเรียนสำเร็จ ${newStudents.length} คน`, 'success');
                    } else {
                        Swal.fire('แจ้งเตือน', 'ไม่พบรายชื่อในไฟล์ Excel กรุณาตรวจสอบหัวตาราง', 'warning');
                    }
                } catch (err) {
                    console.error(err);
                    Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถอ่านไฟล์ Excel ได้: ' + err.message, 'error');
                } finally {
                    hideLoading();
                    document.getElementById('excel-upload').value = '';
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function renderStudentsTable() {
            const tbody = document.getElementById('students-table-body');
            const searchQ = document.getElementById('student-search').value.toLowerCase();
            const filterG = document.getElementById('filter-grade').value.trim();
            const filterR = document.getElementById('filter-room').value.trim();
            tbody.innerHTML = '';

            let filtered = AppState.students.filter(s => {
                let matchQ = searchQ ? (s.firstname + ' ' + s.lastname + ' ' + s.student_id).toLowerCase().includes(searchQ) : true;
                let matchG = filterG ? s.grade.trim() === filterG : true;
                let matchR = filterR ? String(s.room).trim() === String(filterR) : true;
                return matchQ && matchG && matchR;
            });

            document.getElementById('student-table-info').innerText = `แสดงข้อมูล ${filtered.length} จากทั้งหมด ${AppState.students.length} คน`;

            if(filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center p-8 text-gray-500">ไม่พบข้อมูลนักเรียน (กรุณานำเข้าไฟล์ Excel)</td></tr>';
                return;
            }

            filtered.slice(0, 100).forEach(st => {
                const tr = document.createElement('tr');
                tr.className = 'border-b hover:bg-gray-50';
                tr.innerHTML = `
                    <td class="p-3 text-center">${st.number || '-'}</td>
                    <td class="p-3 text-center text-gray-600">${st.student_id}</td>
                    <td class="p-3 font-medium text-gray-800">${st.firstname} ${st.lastname}</td>
                    <td class="p-3 text-center">${st.grade}</td>
                    <td class="p-3 text-center">${st.room}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // --- Activities Handler ---
        function renderActivities() {
            const tbody = document.getElementById('activities-table-body');
            tbody.innerHTML = '';
            if (AppState.activities.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center p-4 text-gray-500">ไม่มีข้อมูลกิจกรรม</td></tr>';
                return;
            }
            AppState.activities.forEach(act => {
                const tr = document.createElement('tr');
                tr.className = 'border-b hover:bg-gray-50';
                tr.innerHTML = `
                    <td class="p-4">${act.semester}/${act.year}</td>
                    <td class="p-4 font-medium text-primary">${act.name}</td>
                    <td class="p-4">${act.date}</td>
                    <td class="p-4">${act.hours} ชม.</td>
                    <td class="p-4 text-center">
                        <button class="text-red-500 hover:text-red-700" onclick="deleteActivity('${act.id}')"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            lucide.createIcons();
        }

        function openActivityModal() { document.getElementById('activity-modal').classList.remove('hidden'); }
        function closeActivityModal() { document.getElementById('activity-modal').classList.add('hidden'); }

        function handleActivitySubmit(e) {
            e.preventDefault();
            const actData = {
                id: 'ACT' + getUniqueId(),
                year: document.getElementById('act-year').value,
                semester: document.getElementById('act-semester').value,
                name: document.getElementById('act-name').value,
                date: document.getElementById('act-date').value,
                hours: document.getElementById('act-hours').value
            };
            AppState.activities.push(actData);
            closeActivityModal();
            renderActivities();
            populateActivitySelects();
            Swal.fire('สำเร็จ', 'เพิ่มกิจกรรมใหม่เรียบร้อยแล้ว', 'success');
        }

        function deleteActivity(id) {
            AppState.activities = AppState.activities.filter(a => a.id !== id);
            renderActivities();
            populateActivitySelects();
        }

        // --- Evaluation Page Logic ---
        function loadEvaluationData() {
            const actId = document.getElementById('eval-activity').value;
            const grade = document.getElementById('eval-grade').value.trim();
            const room = document.getElementById('eval-room').value.trim();

            if (!actId || !grade || !room) {
                Swal.fire('แจ้งเตือน', 'กรุณาเลือก กิจกรรม, ระดับชั้น และห้องเรียน ให้ครบถ้วน', 'warning');
                return;
            }

            const activity = AppState.activities.find(a => a.id === actId);
            const classStudents = AppState.students.filter(s => s.grade.trim() === grade && String(s.room).trim() === room);
            
            classStudents.sort((a, b) => Number(a.number || 0) - Number(b.number || 0));

            currentEvalContext = { activityId: actId, grade: grade, room: room, students: classStudents };

            document.getElementById('eval-title-display').innerText = `บันทึกผล: ${activity ? activity.name : ''}`;
            document.getElementById('eval-subtitle-display').innerText = `ชั้น ${grade}/${room}`;

            renderEvaluationTable();
            updateEvalStats();
            document.getElementById('eval-area').classList.remove('hidden');
        }

        function renderEvaluationTable() {
            const tbody = document.getElementById('eval-table-body');
            tbody.innerHTML = '';

            if (currentEvalContext.students.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center p-8 text-gray-500">ไม่พบรายชื่อนักเรียนในห้องนี้ (กรุณานำเข้ารายชื่อนักเรียนจาก Excel ก่อน)</td></tr>';
                return;
            }

            currentEvalContext.students.forEach(st => {
                const key = `${currentEvalContext.activityId}_${st.id}`;
                const evalItem = AppState.evaluations[key];
                const result = evalItem ? evalItem.result : null; 

                const tr = document.createElement('tr');
                tr.className = 'border-b hover:bg-gray-50';
                if (result === 'pass') tr.classList.add('bg-green-50');
                if (result === 'fail') tr.classList.add('bg-red-50');

                tr.innerHTML = `
                    <td class="p-3 text-center">${st.number || '-'}</td>
                    <td class="p-3 text-center text-gray-600">${st.student_id}</td>
                    <td class="p-3 font-medium text-gray-800">${st.firstname} ${st.lastname}</td>
                    <td class="p-3 text-center">
                        <div class="flex justify-center gap-4">
                            <label class="inline-flex items-center cursor-pointer">
                                <input type="radio" name="res_${st.id}" value="pass" class="form-radio text-success w-5 h-5" 
                                    ${result === 'pass' ? 'checked' : ''} onchange="markRowResult('${st.id}', 'pass', this)">
                                <span class="ml-2 text-sm font-medium ${result === 'pass' ? 'text-success' : 'text-gray-600'}">ผ่าน</span>
                            </label>
                            <label class="inline-flex items-center cursor-pointer">
                                <input type="radio" name="res_${st.id}" value="fail" class="form-radio text-danger w-5 h-5"
                                    ${result === 'fail' ? 'checked' : ''} onchange="markRowResult('${st.id}', 'fail', this)">
                                <span class="ml-2 text-sm font-medium ${result === 'fail' ? 'text-danger' : 'text-gray-600'}">ไม่ผ่าน</span>
                            </label>
                        </div>
                    </td>
                    <td class="p-3">
                        <input type="text" id="note_${st.id}" value="${evalItem ? evalItem.note : ''}" 
                            class="w-full text-sm border-b border-gray-200 focus:border-primary focus:outline-none bg-transparent px-2 py-1"
                            placeholder="ระบุหมายเหตุ...">
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function markRowResult(stId, result, radioElem) {
            const tr = radioElem.closest('tr');
            tr.classList.remove('bg-green-50', 'bg-red-50');
            const spans = tr.querySelectorAll('span');
            spans.forEach(s => s.className = 'ml-2 text-sm font-medium text-gray-600');

            if (result === 'pass') {
                tr.classList.add('bg-green-50');
                radioElem.nextElementSibling.className = 'ml-2 text-sm font-medium text-success';
            } else {
                tr.classList.add('bg-red-50');
                radioElem.nextElementSibling.className = 'ml-2 text-sm font-medium text-danger';
            }
            updateEvalStats();
        }

        function setAllPass() {
            currentEvalContext.students.forEach(st => {
                const radioPass = document.querySelector(`input[name="res_${st.id}"][value="pass"]`);
                if(radioPass) {
                    radioPass.checked = true;
                    markRowResult(st.id, 'pass', radioPass);
                }
            });
            updateEvalStats();
        }

        function updateEvalStats() {
            let pass = 0, fail = 0;
            const total = currentEvalContext.students.length;
            currentEvalContext.students.forEach(st => {
                const sel = document.querySelector(`input[name="res_${st.id}"]:checked`);
                if (sel) {
                    if (sel.value === 'pass') pass++;
                    if (sel.value === 'fail') fail++;
                }
            });
            const pending = total - pass - fail;
            const percent = total > 0 ? ((pass / total) * 100).toFixed(2) : 0;

            document.getElementById('eval-stat-total').innerText = total;
            document.getElementById('eval-stat-pass').innerText = pass;
            document.getElementById('eval-stat-fail').innerText = fail;
            document.getElementById('eval-stat-pending').innerText = pending;
            document.getElementById('eval-stat-percent').innerText = `${percent}%`;
        }

        function saveEvaluation() {
            showLoading('กำลังบันทึกผลการประเมิน...');
            const actId = currentEvalContext.activityId;
            let payload = [];
            let isSavedLocally = false;

            currentEvalContext.students.forEach(st => {
                const sel = document.querySelector(`input[name="res_${st.id}"]:checked`);
                const noteInput = document.getElementById(`note_${st.id}`);
                const note = noteInput ? noteInput.value : '';
                
                if (sel) {
                    const resultVal = sel.value;
                    const evalKey = `${actId}_${st.id}`;
                    
                    AppState.evaluations[evalKey] = { result: resultVal, note: note };
                    payload.push({ eval_key: evalKey, activity_id: actId, student_id: st.id, result: resultVal, note: note });
                    isSavedLocally = true;
                }
            });

            setTimeout(() => {
                hideLoading();
                if(isSavedLocally) {
                    Swal.fire('สำเร็จ', 'บันทึกผลการประเมินเรียบร้อยแล้ว', 'success');
                    
                    if(document.getElementById('page-dashboard').classList.contains('block')) {
                        initDashboard(); 
                    }
                    
                    fetch(API_URL, {
                        method: 'POST',
                        body: JSON.stringify({ action: 'saveEvaluation', payload: payload })
                    }).catch(err => console.log('Sync offline'));
                } else {
                    Swal.fire('แจ้งเตือน', 'ไม่มีข้อมูลการประเมินใหม่ให้บันทึก', 'info');
                }
            }, 500);
        }

        // --- Dashboard & Summary ---
        function initDashboard() {
            document.getElementById('dash-total-students').innerText = AppState.students.length;
            
            let tPass = 0, tFail = 0;
            Object.values(AppState.evaluations).forEach(e => {
                if(e.result === 'pass') tPass++;
                if(e.result === 'fail') tFail++;
            });
            
            document.getElementById('dash-passed').innerText = tPass;
            document.getElementById('dash-failed').innerText = tFail;
            document.getElementById('dash-activities').innerText = AppState.activities.length;
            
            renderCharts(tPass, tFail);
        }

        function renderCharts(tPass, tFail) {
            const ctx1 = document.getElementById('overviewChart');
            if(overviewChartInstance) overviewChartInstance.destroy();
            
            let totalEvalsExpected = AppState.students.length * AppState.activities.length;
            let pending = Math.max(0, totalEvalsExpected - tPass - tFail);

            overviewChartInstance = new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: ['ผ่าน', 'ไม่ผ่าน', 'ยังไม่ประเมิน'],
                    datasets: [{
                        data: [tPass, tFail, pending],
                        backgroundColor: ['#22c55e', '#ef4444', '#e5e7eb'],
                        borderWidth: 1
                    }]
                },
                options: { 
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            let gradeData = {};
            Object.keys(AppState.classes).forEach(g => {
                gradeData[g] = { pass: 0, fail: 0 };
            });

            AppState.students.forEach(st => {
                let g = st.grade.trim();
                if(!gradeData[g]) gradeData[g] = { pass: 0, fail: 0 };
                
                AppState.activities.forEach(act => {
                    let ev = AppState.evaluations[`${act.id}_${st.id}`];
                    if(ev) {
                        if(ev.result === 'pass') gradeData[g].pass++;
                        if(ev.result === 'fail') gradeData[g].fail++;
                    }
                });
            });

            const labels = Object.keys(gradeData);
            const passData = labels.map(l => gradeData[l].pass);
            const failData = labels.map(l => gradeData[l].fail);

            const ctx2 = document.getElementById('gradeChart');
            if(gradeChartInstance) gradeChartInstance.destroy();
            
            gradeChartInstance = new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'ผ่าน', data: passData, backgroundColor: '#22c55e' },
                        { label: 'ไม่ผ่าน', data: failData, backgroundColor: '#ef4444' }
                    ]
                },
                options: { 
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        function generateSummary() {
            const actId = document.getElementById('sum-activity').value;
            const gradeFilter = document.getElementById('sum-grade').value.trim();
            const tbody = document.getElementById('summary-table-body');
            tbody.innerHTML = '';

            if(!actId) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center p-8 text-gray-500">กรุณาเลือกกิจกรรม</td></tr>';
                return;
            }

            let groups = {};
            AppState.students.forEach(st => {
                if(gradeFilter && st.grade.trim() !== gradeFilter) return;
                
                const key = `${st.grade.trim()}/${String(st.room).trim()}`;
                if(!groups[key]) groups[key] = { grade: st.grade.trim(), room: String(st.room).trim(), total: 0, pass: 0, fail: 0 };
                groups[key].total++;

                const ev = AppState.evaluations[`${actId}_${st.id}`];
                if(ev) {
                    if(ev.result === 'pass') groups[key].pass++;
                    if(ev.result === 'fail') groups[key].fail++;
                }
            });

            const list = Object.values(groups);
            if(list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center p-8 text-gray-500">ไม่พบข้อมูลนักเรียน</td></tr>';
                return;
            }

            list.forEach(c => {
                const pending = c.total - c.pass - c.fail;
                const pct = c.total > 0 ? ((c.pass / c.total) * 100).toFixed(2) : "0.00";
                const tr = document.createElement('tr');
                tr.className = 'border-b hover:bg-gray-50';
                tr.innerHTML = `
                    <td class="p-3 text-center font-medium">${c.grade}/${c.room}</td>
                    <td class="p-3 text-center">${c.total}</td>
                    <td class="p-3 text-center text-success font-semibold">${c.pass}</td>
                    <td class="p-3 text-center text-danger font-semibold">${c.fail}</td>
                    <td class="p-3 text-center text-gray-500">${pending}</td>
