// โค้ด Backend สำหรับ Google Apps Script (GAS) ระบบกิจกรรมเพื่อสังคมฯ
const SHEET_ID = 'ใส่_ID_ของ_Google_Sheet_ที่นี่'; // ตัวอย่างเช่น '1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms'

function doGet(e) {
  const action = e.parameter ? e.parameter.action : '';
  
  try {
    if (action === 'getStudents') {
      return returnJSON(getData('students'));
    }
    if (action === 'getActivities') {
      return returnJSON(getData('activities'));
    }
    if (action === 'getEvaluations') {
      return returnJSON(getData('evaluations'));
    }
    
    return returnJSON({status: 'success', message: 'API is running smoothly.'});
  } catch(error) {
    return returnJSON({status: 'error', message: error.toString()});
  }
}

function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);
    const action = data.action;
    
    if (action === 'saveEvaluation') {
       saveEvaluationData(data.payload);
       return returnJSON({status: 'success'});
    }
    
    if (action === 'saveStudents') {
       saveStudentsData(data.payload);
       return returnJSON({status: 'success'});
    }
    
    return returnJSON({status: 'error', message: 'Unknown action: ' + action});
  } catch(error) {
    return returnJSON({status: 'error', message: error.toString()});
  }
}

// --- Helper Functions ---
function returnJSON(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

function getData(sheetName) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return [];
  
  const range = sheet.getDataRange();
  const data = range.getValues();
  if (data.length <= 1) return []; // ไม่มีข้อมูลหรือมีแต่หัวตาราง
  
  const headers = data[0];
  const result = [];
  
  for (let i = 1; i < data.length; i++) {
    let obj = {};
    for (let j = 0; j < headers.length; j++) {
      obj[headers[j]] = data[i][j];
    }
    result.push(obj);
  }
  return result;
}

function saveEvaluationData(evaluations) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const sheet = ss.getSheetByName('evaluations');
  if (!sheet) return;
  
  const data = sheet.getDataRange().getValues();
  const headers = data[0];
  const keyIndex = headers.indexOf('eval_key');
  
  let existingKeys = {};
  for(let i = 1; i < data.length; i++) {
    if(keyIndex !== -1) {
      existingKeys[data[i][keyIndex]] = i + 1; // บันทึกหมายเลขแถว
    }
  }
  
  const timestamp = new Date();
  
  evaluations.forEach(ev => {
    if(keyIndex !== -1 && existingKeys[ev.eval_key]) {
      // อัปเดตข้อมูลเดิม
      const rowNum = existingKeys[ev.eval_key];
      sheet.getRange(rowNum, 4).setValue(ev.result); // คอลัมน์ result
      sheet.getRange(rowNum, 5).setValue(ev.note);   // คอลัมน์ note
      sheet.getRange(rowNum, 6).setValue(timestamp); // คอลัมน์ timestamp
    } else {
      // เพิ่มแถวใหม่
      sheet.appendRow([ev.eval_key, ev.activity_id, ev.student_id, ev.result, ev.note, timestamp]);
    }
  });
}

function saveStudentsData(students) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const sheet = ss.getSheetByName('students');
  if (!sheet) return;
  
  students.forEach(st => {
    // โครงสร้างชีต students: id, student_id, firstname, lastname, grade, room, number
    sheet.appendRow([st.id, st.student_id, st.firstname, st.lastname, st.grade, st.room, st.number]);
  });
}
