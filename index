        async function downloadPDF() {
            const el = document.getElementById('report-preview');
            if(!el || !el.innerHTML.trim()) {
                Swal.fire('แจ้งเตือน', 'กรุณากด "ดูตัวอย่างเอกสาร" ก่อนดาวน์โหลด PDF', 'warning');
                return;
            }
            showLoading('กำลังสร้างไฟล์ PDF...');
            try {
                const canvas = await html2canvas(el, { scale: 2, useCORS: true });
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const imgData = canvas.toDataURL('image/png');
                const imgWidth = 210;
                const pageHeight = 297;
                const imgHeight = (canvas.height * imgWidth) / canvas.width;
                let heightLeft = imgHeight;
                let position = 0;

                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;

                while (heightLeft >= 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;
                }

                const grade = document.getElementById('rep-grade').value.replace('ม.','');
                const room = document.getElementById('rep-room').value;
                pdf.save(`รายงานประเมินกิจกรรม-ม.${grade}-${room}.pdf`);
            } catch (err) {
                console.error(err);
                Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถสร้างไฟล์ PDF ได้', 'error');
            } finally {
                hideLoading();
            }
        }

