<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบกิจกรรมเพื่อสังคมและสาธารณประโยชน์</title>
    
    <!-- Google Fonts: Kanit & Sarabun -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Kanit', 'sans-serif'],
                        sarabun: ['Sarabun', 'sans-serif'],
                    },
                    colors: {
                        primary: '#0d9488', // Teal 600
                        'primary-hover': '#0f766e', // Teal 700
                        secondary: '#4ade80', // Green 400
                        success: '#22c55e', // Green 500
                        danger: '#ef4444', // Red 500
                        warning: '#f97316', // Orange 500
                    }
                }
            }
        }
    </script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- XLSX for Excel Export/Import -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- jsPDF & html2canvas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        body {
            background-color: #f3f4f6;
            font-family: 'Kanit', sans-serif;
        }
        
        .sidebar-active {
            background-color: #e0f2fe;
            color: #0369a1;
            border-right: 4px solid #0284c7;
            font-weight: 500;
        }

        .loader {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #0d9488;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background-color: white; }
            #report-preview-container { background: white !important; padding: 0 !important; box-shadow: none !important; }
        }
        
        .print-only { display: none; }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="text-gray-800 h-screen flex overflow-hidden">

    <!-- Sidebar -->
    <aside id="sidebar" class="bg-white w-64 h-full shadow-lg flex flex-col transition-transform transform -translate-x-full md:translate-x-0 absolute md:relative z-40 fixed">
        <div class="p-4 border-b flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i data-lucide="graduation-cap" class="text-primary w-8 h-8"></i>
                <span class="font-bold text-lg text-primary leading-tight">ระบบกิจกรรม<br>เพื่อสังคมฯ</span>
            </div>
            <button id="close-sidebar" class="md:hidden text-gray-500 hover:text-gray-700" onclick="toggleSidebar()">
                <i data-lucide="x"></i>
            </button>
        </div>

        <div class="p-4 flex flex-col items-center border-b bg-gray-50">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold mb-2 shadow-sm">
                <span id="user-initial">ค</span>
            </div>
            <p id="user-name-display" class="font-semibold text-gray-700">คุณครู สมมติ</p>
            <p class="text-xs text-gray-500 bg-gray-200 px-2 py-1 rounded-full mt-1">ผู้ดูแลระบบ</p>
        </div>
        
        <nav class="flex-1 overflow-y-auto py-4">
            <ul class="space-y-1">
                <li>
                    <a href="#" onclick="navigate('dashboard')" class="nav-item flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors sidebar-active" data-page="dashboard">
                        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="#" onclick="navigate('activities')" class="nav-item flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors" data-page="activities">
                        <i data-lucide="calendar" class="w-5 h-5"></i>
                        <span>จัดการกิจกรรม</span>
                    </a>
                </li>
                <li>
                    <a href="#" onclick="navigate('students')" class="nav-item flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors" data-page="students">
                        <i data-lucide="users" class="w-5 h-5"></i>
                        <span>รายชื่อนักเรียน</span>
                    </a>
                </li>
                <li class="pt-4 pb-2 px-6 text-xs font-semibold text-gray-400 uppercase tracking-wider">การประเมิน</li>
                <li>
                    <a href="#" onclick="navigate('evaluate')" class="nav-item flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors" data-page="evaluate">
                        <i data-lucide="clipboard-check" class="w-5 h-5"></i>
                        <span>บันทึกผลการประเมิน</span>
                    </a>
                </li>
                <li>
                    <a href="#" onclick="navigate('summary')" class="nav-item flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors" data-page="summary">
                        <i data-lucide="pie-chart" class="w-5 h-5"></i>
                        <span>สรุปผลรายห้อง</span>
                    </a>
                </li>
                <li>
                    <a href="#" onclick="navigate('report')" class="nav-item flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors" data-page="report">
                        <i data-lucide="file-text" class="w-5 h-5"></i>
                        <span>พิมพ์รายงาน (PDF)</span>
                    </a>
                </li>
                <li class="pt-4 pb-2 px-6 text-xs font-semibold text-gray-400 uppercase tracking-wider">ระบบ</li>
                <li>
                    <a href="#" onclick="logout()" class="flex items-center gap-3 px-6 py-3 text-red-500 hover:bg-red-50 transition-colors">
                        <i data-lucide="log-out" class="w-5 h-5"></i>
                        <span>ออกจากระบบ</span>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <div id="sidebar-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-30 hidden md:hidden no-print" onclick="toggleSidebar()"></div>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col h-full relative w-full bg-gray-50">
        
        <!-- Top Header -->
        <header class="bg-white shadow-sm border-b h-16 flex items-center justify-between px-4 lg:px-8 no-print shrink-0 z-10">
            <div class="flex items-center gap-4">
                <button id="open-sidebar" class="md:hidden text-gray-500 hover:text-gray-700 focus:outline-none" onclick="toggleSidebar()">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
                <h1 id="page-title" class="text-xl font-semibold text-gray-800">Dashboard</h1>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm text-gray-500 hidden sm:inline-block" id="current-date-display"></span>
            </div>
        </header>

        <!-- Loading Overlay -->
        <div id="loading-overlay" class="absolute inset-0 bg-white bg-opacity-80 z-50 flex flex-col items-center justify-center hidden">
            <div class="loader mb-4"></div>
            <p class="text-primary font-medium" id="loading-text">กำลังโหลดข้อมูล...</p>
        </div>

        <!-- Scrollable Content Area -->
        <main class="flex-1 overflow-y-auto p-4 lg:p-8" id="main-content">
            
            <!-- 1. Dashboard Page -->
            <div id="page-dashboard" class="page-content block">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center gap-4 border-l-4 border-l-blue-500">
                        <div class="bg-blue-50 text-blue-500 p-3 rounded-lg"><i data-lucide="users" class="w-8 h-8"></i></div>
                        <div><p class="text-sm text-gray-500 font-medium">นักเรียนทั้งหมด</p><h3 class="text-2xl font-bold text-gray-800" id="dash-total-students">0</h3></div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center gap-4 border-l-4 border-l-success">
                        <div class="bg-green-50 text-success p-3 rounded-lg"><i data-lucide="check-circle" class="w-8 h-8"></i></div>
                        <div><p class="text-sm text-gray-500 font-medium">บันทึก "ผ่าน"</p><h3 class="text-2xl font-bold text-gray-800" id="dash-passed">0</h3></div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center gap-4 border-l-4 border-l-danger">
                        <div class="bg-red-50 text-danger p-3 rounded-lg"><i data-lucide="x-circle" class="w-8 h-8"></i></div>
                        <div><p class="text-sm text-gray-500 font-medium">บันทึก "ไม่ผ่าน"</p><h3 class="text-2xl font-bold text-gray-800" id="dash-failed">0</h3></div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center gap-4 border-l-4 border-l-primary">
                        <div class="bg-teal-50 text-primary p-3 rounded-lg"><i data-lucide="calendar" class="w-8 h-8"></i></div>
                        <div><p class="text-sm text-gray-500 font-medium">กิจกรรมทั้งหมด</p><h3 class="text-2xl font-bold text-gray-800" id="dash-activities">0</h3></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">สัดส่วนผลการประเมินภาพรวม (ที่มีการบันทึก)</h3>
                        <div class="h-64 flex items-center justify-center relative"><canvas id="overviewChart"></canvas></div>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">ผลการประเมินแยกระดับชั้น (ข้อมูลที่บันทึกแล้ว)</h3>
                        <div class="h-64 relative"><canvas id="gradeChart"></canvas></div>
                    </div>
                </div>
            </div>

            <!-- 2. Activities Page -->
            <div id="page-activities" class="page-content hidden">
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                        <h2 class="text-lg font-semibold text-gray-800">รายการกิจกรรม</h2>
                        <button onclick="openActivityModal()" class="bg-primary hover:bg-primary-hover text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                            <i data-lucide="plus" class="w-4 h-4"></i> เพิ่มกิจกรรมใหม่
                        </button>
                    </div>
                    <div class="p-0 overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50 text-gray-600 text-sm border-b">
                                    <th class="p-4 font-medium">ปี/เทอม</th>
                                    <th class="p-4 font-medium">ชื่อกิจกรรม</th>
                                    <th class="p-4 font-medium">วันที่จัด</th>
                                    <th class="p-4 font-medium">ชั่วโมง</th>
                                    <th class="p-4 font-medium text-center">จัดการ</th>
                                </tr>
                            </thead>
                            <tbody id="activities-table-body" class="text-sm"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 3. Students Page -->
            <div id="page-students" class="page-content hidden">
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-6">
                    <div class="p-6 border-b">
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-4">
                            <h2 class="text-lg font-semibold text-gray-800">จัดการรายชื่อนักเรียน</h2>
                            <div class="flex gap-2">
                                <button onclick="document.getElementById('excel-upload').click()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                                    <i data-lucide="file-spreadsheet" class="w-4 h-4"></i> นำเข้า Excel
                                </button>
                                <input type="file" id="excel-upload" accept=".xlsx, .xls" class="hidden" onchange="handleExcelUpload(event)">
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div>
                                <label class="block text-xs text-gray-500 mb-1">ค้นหา</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"><i data-lucide="search" class="text-gray-400 w-4 h-4"></i></div>
                                    <input type="text" id="student-search" placeholder="ชื่อ, รหัสนักเรียน..." oninput="renderStudentsTable()" class="pl-10 w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-primary focus:border-primary outline-none">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 mb-1">ระดับชั้น</label>
                                <select id="filter-grade" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-primary outline-none" onchange="updateClassDropdown('filter'); renderStudentsTable();">
                                    <option value="">ทั้งหมด</option>
                                    <option value="ม.1">มัธยมศึกษาปีที่ 1</option>
                                    <option value="ม.2">มัธยมศึกษาปีที่ 2</option>
                                    <option value="ม.3">มัธยมศึกษาปีที่ 3</option>
                                    <option value="ม.4">มัธยมศึกษาปีที่ 4</option>
                                    <option value="ม.5">มัธยมศึกษาปีที่ 5</option>
                                    <option value="ม.6">มัธยมศึกษาปีที่ 6</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 mb-1">ห้อง</label>
                                <select id="filter-room" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-primary outline-none" onchange="renderStudentsTable()">
                                    <option value="">ทั้งหมด</option>
                                </select>
                            </div>
                            <div class="flex items-end">
                                <button onclick="renderStudentsTable()" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                                    รีเซ็ตตัวกรอง
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="p-0 overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[800px]">
                            <thead>
                                <tr class="bg-gray-50 text-gray-600 text-sm border-b">
                                    <th class="p-4 font-medium w-16 text-center">เลขที่</th>
                                    <th class="p-4 font-medium w-32 text-center">รหัสประจำตัว</th>
                                    <th class="p-4 font-medium">ชื่อ - นามสกุล</th>
                                    <th class="p-4 font-medium w-24 text-center">ระดับชั้น</th>
                                    <th class="p-4 font-medium w-24 text-center">ห้อง</th>
                                </tr>
                            </thead>
                            <tbody id="students-table-body" class="text-sm"></tbody>
                        </table>
                    </div>
                    <div class="p-4 border-t text-sm text-gray-500 flex justify-between items-center" id="student-table-info">แสดงข้อมูลนักเรียนทั้งหมด</div>
                </div>
            </div>

            <!-- 4. Evaluate Page -->
            <div id="page-evaluate" class="page-content hidden">
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">เลือกข้อมูลสำหรับการประเมิน</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">กิจกรรม <span class="text-red-500">*</span></label>
                            <select id="eval-activity" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-primary outline-none bg-gray-50">
                                <option value="">-- เลือกกิจกรรม --</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">ระดับชั้น <span class="text-red-500">*</span></label>
                            <select id="eval-grade" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-primary outline-none" onchange="updateClassDropdown('eval')">
                                <option value="">-- เลือกระดับชั้น --</option>
                                <option value="ม.1">มัธยมศึกษาปีที่ 1</option>
                                <option value="ม.2">มัธยมศึกษาปีที่ 2</option>
                                <option value="ม.3">มัธยมศึกษาปีที่ 3</option>
                                <option value="ม.4">มัธยมศึกษาปีที่ 4</option>
                                <option value="ม.5">มัธยมศึกษาปีที่ 5</option>
                                <option value="ม.6">มัธยมศึกษาปีที่ 6</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">ห้องเรียน <span class="text-red-500">*</span></label>
                            <select id="eval-room" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-primary outline-none disabled:bg-gray-100 disabled:text-gray-400" disabled>
                                <option value="">-- เลือกห้อง --</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-4 flex justify-end">
                        <button onclick="loadEvaluationData()" class="bg-primary hover:bg-primary-hover text-white px-6 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                            <i data-lucide="search" class="w-4 h-4"></i> ดึงข้อมูลนักเรียน
                        </button>
                    </div>
                </div>

                <div id="eval-area" class="hidden">
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
                        <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm text-center">
                            <p class="text-xs text-gray-500">นักเรียนทั้งหมด</p>
                            <p class="text-xl font-bold text-blue-600" id="eval-stat-total">0</p>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm text-center">
                            <p class="text-xs text-gray-500">ผ่าน</p>
                            <p class="text-xl font-bold text-success" id="eval-stat-pass">0</p>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm text-center">
                            <p class="text-xs text-gray-500">ไม่ผ่าน</p>
                            <p class="text-xl font-bold text-danger" id="eval-stat-fail">0</p>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm text-center">
                            <p class="text-xs text-gray-500">ยังไม่ประเมิน</p>
                            <p class="text-xl font-bold text-gray-600" id="eval-stat-pending">0</p>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm text-center col-span-2 md:col-span-1">
                            <p class="text-xs text-gray-500">ร้อยละการผ่าน</p>
                            <p class="text-xl font-bold text-primary" id="eval-stat-percent">0%</p>
                        </div>
                    </div>

                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="p-4 border-b flex flex-col md:flex-row justify-between items-center gap-4 bg-gray-50">
                            <div>
                                <h3 class="font-semibold text-gray-800" id="eval-title-display">บันทึกผลการประเมิน</h3>
                                <p class="text-sm text-gray-500" id="eval-subtitle-display">ชั้น ...</p>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="setAllPass()" class="bg-green-100 text-green-700 hover:bg-green-200 border border-green-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                                    <i data-lucide="check-check" class="w-4 h-4 inline mr-1"></i> ให้ "ผ่าน" ทั้งหมด
                                </button>
                                <button onclick="saveEvaluation()" class="bg-primary hover:bg-primary-hover text-white px-6 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
                                    <i data-lucide="save" class="w-4 h-4 inline mr-1"></i> บันทึกผล
                                </button>
                            </div>
                        </div>
                        
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse min-w-[900px]">
                                <thead>
                                    <tr class="bg-white text-gray-600 text-sm border-b">
                                        <th class="p-3 font-medium w-12 text-center">เลขที่</th>
                                        <th class="p-3 font-medium w-24 text-center">รหัสนักเรียน</th>
                                        <th class="p-3 font-medium w-48">ชื่อ - นามสกุล</th>
